# Base URLs for API endpoints
PROD_BASE_URL=https://water-purifier.onrender.com
DEV_BASE_URL=https://water-purifier.onrender.com
TESTING_BASE_URL=https://water-purifier.onrender.com
BASE_URL_WEBVIEW=https://water-purifier-ten.vercel.app/
# Firebase configuration for authentication
FIREBASE_API_KEY=your_firebase_api_key 
FIREBASE_APP_ID=your_firebase_app_id 
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id 
FIREBASE_PROJECT_ID=your_firebase_project_id 
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket

# Notification settings for flutter_local_notifications
NOTIFICATION_CHANNEL_ID=aquapulse_channel 
NOTIFICATION_CHANNEL_NAME=AquaPulse Notifications 
NOTIFICATION_CHANNEL_DESCRIPTION=Notifications for device status and service requests

# API keys for external services
ANALYTICS_API_KEY=your_analytics_api_key 
PAYMENT_GATEWAY_KEY=your_payment_gateway_keyaS

# Support and app metadata
SUPPORT_EMAIL=support@aquapulse.com 
SUPPORT_PHONE=+1144567890 
APP_VERSION=1.0.0